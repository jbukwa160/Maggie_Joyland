AUTH_SECRET=change-me-to-a-long-random-string
# Database + uploaded images. Keep it OUTSIDE the project folder when running `npm run dev`.
DATA_DIR=/var/lib/maggie-joyland
SITE_URL=https://maggiejoyland.bg

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

SPEEDY_USERNAME=
SPEEDY_PASSWORD=

ECONT_USERNAME=
ECONT_PASSWORD=
ECONT_ENV=production

BOXNOW_API_URL=https://api-production.boxnow.bg
BOXNOW_CLIENT_ID=
BOXNOW_CLIENT_SECRET=
BOXNOW_PARTNER_ID=
BOXNOW_WAREHOUSE_ID=

# ─── Pigeon Express (https://api-docs.pigeonexpress.com) ───
PIGEON_API_KEY=
PIGEON_API_SECRET=
# "demo" = sandbox https://api-demo.pigeonexpress.com/v1 (needs sandbox keys); empty = production
PIGEON_ENV=
# Optional: PIGEON_PACKAGE_SIZE=30x20x15 (cm), PIGEON_LABEL_FORMAT=default|pdf150|a4, PIGEON_SERVICE_TYPE=standard|express, PIGEON_WHO_PAYS=sender|receiver
